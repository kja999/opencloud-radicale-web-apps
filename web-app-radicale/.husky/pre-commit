#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

cd web-app-radicale

echo "Running pre-commit checks..."

# Run lint-staged on staged files
npx lint-staged

# Run type check
echo "Running type check..."
npx vue-tsc --noEmit

# Run tests
echo "Running unit tests..."
npx vitest run

echo "All pre-commit checks passed!"